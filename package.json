{
  "name": "family-gathering",
  "version": "1.0.0",
  "private": true,
  "description": "Family Gathering KLKM Jakarta Utara - Admin & Kepala Rombongan (Android native) dan Peserta (PWA)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages --ext .ts,.tsx",
    "admin": "npm run start --workspace @fg/admin",
    "kepala": "npm run start --workspace @fg/kepala",
    "pwa": "npm run dev --workspace @fg/peserta-pwa",
    "pwa:build": "npm run build --workspace @fg/peserta-pwa"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  }
}
