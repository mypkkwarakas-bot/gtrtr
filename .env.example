# Salin ke apps/admin/.env dan apps/kepala/.env untuk pengembangan lokal.
# File .env TIDAK boleh di-commit. Untuk build EAS, definisikan variabel yang sama
# di EAS Environment Variables (lihat docs/EAS_BUILD.md).

# --- Supabase (kunci publishable/anon; AMAN berada di klien karena dibatasi RLS) ---
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Google Maps SDK for Android (dibaca saat build oleh app.config.ts) ---
# Batasi key ke package name + SHA-1 signing certificate di Google Cloud Console.
GOOGLE_MAPS_ANDROID_API_KEY=

# --- EAS project id (didapat dari `eas init` di tiap folder aplikasi) ---
EAS_PROJECT_ID=

# JANGAN PERNAH menaruh SUPABASE_SERVICE_ROLE_KEY di sini atau di aplikasi mana pun.
